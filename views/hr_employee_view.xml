<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_correspondence" model="ir.ui.view">
        <field name="name">hr.employee.form.correspondence</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <field name="is_correspondence_manager" invisible="1"/>
                
                <page string="Correspondencia" name="correspondence" invisible="not is_correspondence_manager">
                    <group>
                        <group string="Información del Director">
                            <field name="director_description"/>
                        </group>
                        <group string="Sellos y Firmas">
                            <field name="director_signature" widget="image" class="oe_avatar" options="{'size': [128, 128]}"/>
                            <field name="director_stamp" widget="image" class="oe_avatar" options="{'size': [128, 128]}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>