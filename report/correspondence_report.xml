<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =================================================================== -->
    <!--         LAYOUT PERSONALIZADO PARA TODOS LOS REPORTES                -->
    <!-- =================================================================== -->
    <template id="external_layout_correspondence" inherit_id="web.external_layout_standard" primary="True">
        <xpath expr="//div[contains(@class, 'header') or contains(@t-attf-class, 'header')]" position="replace">
            <div t-attf-class="header o_company_#{company.id}_layout" style="margin: 0 !important; padding: 0 10mm 0 10mm !important; width: 100% !important; box-sizing: border-box !important;">
                <style>
                    @import url('https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,400;0,700;1,400;1,700&amp;display=swap');
                    body, .page, table, div, p, span, td, th {
                        font-family: 'Georama', Arial, sans-serif !important;
                    }
                    div.article, .article, div.page, .page {
                        padding-left: 25.4mm !important;
                        padding-right: 25.4mm !important;
                        box-sizing: border-box !important;
                    }
                </style>
                <div class="d-flex justify-content-between align-items-center" style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 0px; width: 100%;">
                    <div style="width: 45%;"> 
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 75px;" alt="Ministerio Logo"/>
                        <img t-else="" src="/correspondence/static/src/img/logo-izquierda.png" style="max-height: 75px;" alt="Ministerio Logo"/>
                    </div>
                    <div style="border-left: 1px solid #666; height: 60px; margin: 0 10px;"></div>
                    <div style="width: 45%; text-align: right;">
                        <img src="/correspondence/static/src/img/logo-derecha.png" style="max-height: 75px;" alt="CENIPA Logo"/>
                    </div>
                </div>
            </div>
        </xpath>
        <!-- Padding lateral (25.4mm / 2.54cm) EXCLUSIVO para el cuerpo del reporte -->
        <xpath expr="//div[contains(@class, 'article') or contains(@t-attf-class, 'article')]" position="attributes">
            <attribute name="style">padding-top: 0px !important; padding-left: 25.4mm !important; padding-right: 25.4mm !important; box-sizing: border-box !important;</attribute>
        </xpath>
        <!-- Footer personalizado de ancho completo (100% sangrado) con QR redondeado, Contacto y Redes Sociales -->
        <xpath expr="//div[contains(@class, 'footer') or contains(@t-attf-class, 'footer')]" position="replace">
            <div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout" style="margin: 0 !important; padding: 0 !important; width: 100% !important; position: relative; height: 135px; page-break-inside: avoid;">
                <img src="/correspondence/static/src/img/footer.png" style="width: 100%; max-height: 120px; position: absolute; bottom: 0; left: 0; right: 0; margin: 0; padding: 0; display: block;" alt="Footer Image"/>
                <t t-set="qr_img" t-value="doc.get_qr_code_url() if doc else False"/>
                
                <!-- Tarjeta QR Minimalista con Bordes Redondeados (Esquina Izquierda: 6mm) -->
                <div t-if="qr_img" style="position: absolute; bottom: 8px; left: 6mm; z-index: 10; background-color: #ffffff; padding: 5px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.18);">
                    <img t-att-src="qr_img" style="width: 70px; height: 70px; border-radius: 8px; display: block;" alt="Código QR de Verificación"/>
                </div>

                <!-- Bloque de Contacto Institucional (Izquierda: 28mm, Ancho máximo delimitado a media página: 88mm) -->
                <div style="position: absolute; bottom: 8px; left: 28mm; width: 88mm; max-width: 88mm; z-index: 10; font-family: 'Georama', Arial, sans-serif; text-align: left;">
                    <!-- Fila 1: Teléfono -->
                    <div style="margin-bottom: 2px; line-height: 1.2;">
                        <div style="display: inline-block; width: 14px; height: 14px; background-color: #000000; border-radius: 50%; text-align: center; vertical-align: middle; line-height: 14px; margin-right: 4px;">
                            <svg width="8" height="8" viewBox="0 0 24 24" fill="#ffffff" style="vertical-align: middle; margin-top: -2px;">
                                <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24 11.36 11.36 0 003.58.57 1 1 0 011 1v3.5a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.36 11.36 0 00.57 3.58 1 1 0 01-.24 1.02l-2.21 2.19z"/>
                            </svg>
                        </div>
                        <span style="font-size: 8pt; font-weight: bold; color: #000000; vertical-align: middle;">0212-5072911 ext 8049</span>
                    </div>

                    <!-- Fila 2: Redes Sociales (Instagram, Facebook, TikTok, YouTube + @cenipave en Negrita) -->
                    <div style="margin-bottom: 2px; line-height: 1.2;">
                        <!-- Instagram -->
                        <div style="display: inline-block; width: 14px; height: 14px; background-color: #000000; border-radius: 50%; text-align: center; vertical-align: middle; line-height: 14px; margin-right: 2px;">
                            <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-top: -2px;">
                                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                                <circle cx="17.5" cy="6.5" r="1.5" fill="#ffffff"></circle>
                            </svg>
                        </div>
                        <!-- Facebook -->
                        <div style="display: inline-block; width: 14px; height: 14px; background-color: #000000; border-radius: 50%; text-align: center; vertical-align: middle; line-height: 14px; margin-right: 2px;">
                            <svg width="8" height="8" viewBox="0 0 24 24" fill="#ffffff" style="vertical-align: middle; margin-top: -2px;">
                                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                            </svg>
                        </div>
                        <!-- TikTok -->
                        <div style="display: inline-block; width: 14px; height: 14px; background-color: #000000; border-radius: 50%; text-align: center; vertical-align: middle; line-height: 14px; margin-right: 2px;">
                            <svg width="7" height="7" viewBox="0 0 24 24" fill="#ffffff" style="vertical-align: middle; margin-top: -2px;">
                                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 15.68a6.34 6.34 0 0 0 10.86 4.43 6.22 6.22 0 0 0 1.88-4.43V8.84a8.16 8.16 0 0 0 4.85 1.59v-3.5a4.86 4.86 0 0 1-1-.24z"/>
                            </svg>
                        </div>
                        <!-- YouTube -->
                        <div style="display: inline-block; width: 14px; height: 14px; background-color: #000000; border-radius: 50%; text-align: center; vertical-align: middle; line-height: 14px; margin-right: 4px;">
                            <svg width="8" height="8" viewBox="0 0 24 24" fill="#ffffff" style="vertical-align: middle; margin-top: -2px;">
                                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                            </svg>
                        </div>
                        <span style="font-size: 8pt; font-weight: bold; color: #000000; vertical-align: middle;">@cenipave</span>
                    </div>

                    <!-- Fila 3: Dirección en Negrita y delimitada -->
                    <div style="line-height: 1.15; width: 100%;">
                        <table style="width: 100%; border: none; border-collapse: collapse; margin: 0; padding: 0;">
                            <tr>
                                <td style="width: 16px; vertical-align: top; padding: 0; border: none;">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-top: 1px;">
                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                        <circle cx="12" cy="10" r="3"></circle>
                                    </svg>
                                </td>
                                <td style="vertical-align: top; padding: 0; border: none;">
                                    <span style="font-size: 6.8pt; font-weight: bold; color: #000000; line-height: 1.15; display: block;">Caracas, Dto. Metropolitano, Municipio Libertador, Av. Lecuna, Parque Central, Torre Este, Piso 22</span>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- =================================================================== -->
    <!--         PLANTILLA REUTILIZABLE PARA EL PIE DE PÁGINA CON QR         -->
    <!-- =================================================================== -->
