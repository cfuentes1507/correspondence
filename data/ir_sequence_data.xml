<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Secuencia para la Correspondencia Entrante -->
        <record id="seq_correspondence_incoming" model="ir.sequence">
            <field name="name">Correspondencia Entrante</field>
            <field name="code">correspondence.incoming</field>
            <field name="prefix"></field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- URL interna para wkhtmltopdf (generación de PDFs).
             Esto evita el timeout cuando web.base.url apunta a una IP externa.
             wkhtmltopdf usará esta URL para cargar CSS/imágenes. -->
        <record id="config_report_url" model="ir.config_parameter">
            <field name="key">report.url</field>
            <field name="value">http://localhost:8003</field>
        </record>
    </data>
</odoo>
